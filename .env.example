# ============================================================
# ShopSphere - Environment Variables Example
# ============================================================
# IMPORTANT:
# This file contains placeholders only.
# NEVER put real API keys, passwords, or secrets in this file.
# Create a separate .env file for your actual local secrets.
# ============================================================


# ============================================================
# GEMINI AI
# ============================================================

GEMINI_API_KEY="YOUR_GEMINI_API_KEY"


# ============================================================
# APPLICATION
# ============================================================

APP_URL="YOUR_PRODUCTION_APP_URL"

PORT=3000

NODE_ENV="production"


# ============================================================
# AUTHENTICATION / SECURITY
# ============================================================

JWT_SECRET="YOUR_PRODUCTION_JWT_SECRET"

OTP_SECRET_SALT="YOUR_SECURE_OTP_SALT"


# ============================================================
# ADMIN INITIAL ACCOUNT
# ============================================================
# Use your own strong credentials in the actual .env file.
# Do NOT put real credentials here.

ADMIN_EMAIL="YOUR_ADMIN_EMAIL"

ADMIN_PHONE="YOUR_ADMIN_PHONE"

ADMIN_PASSWORD="YOUR_SECURE_ADMIN_PASSWORD"


# ============================================================
# GOOGLE OAUTH
# ============================================================
# Required only if Google Sign-In is enabled in production.

GOOGLE_CLIENT_ID=""

GOOGLE_CLIENT_SECRET=""


# ============================================================
# EMAIL / SMTP
# ============================================================
# Optional.
# Leave empty if email notifications are not being used.

SMTP_HOST=""

SMTP_PORT="587"

SMTP_USER=""

SMTP_PASS=""

SMTP_SECURE="false"

EMAIL_FROM="ShopSphere Notifications <notifications@shopsphere.com>"


# ============================================================
# SMS / OTP
# ============================================================
# Configure ONE supported SMS provider for real SMS OTP delivery.

# ---------- Twilio ----------

TWILIO_ACCOUNT_SID=""

TWILIO_AUTH_TOKEN=""

TWILIO_PHONE_NUMBER=""

TWILIO_MESSAGING_SERVICE_SID=""

TWILIO_VERIFY_SERVICE_SID=""

TWILIO_CONTENT_SID=""


# ---------- Fast2SMS ----------

FAST2SMS_API_KEY=""


# ---------- Custom SMS Gateway ----------

SMS_GATEWAY_URL=""


# ============================================================
# END
# ============================================================